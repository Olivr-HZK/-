# 说明：
# - 本文件为 skills/competitor-monitoring 专用环境变量示例。
# - 请复制为 `.env` 并填入真实值；不要提交真实密钥到版本库。

########################
# AI / LLM 配置
########################

# OpenRouter 或 OpenAI API 密钥（二选一或都配置）
OPENROUTER_API_KEY=your-openrouter-api-key
OPENAI_API_KEY=your-openai-api-key

# 可选：模型与超时
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_MODEL_FALLBACKS=moonshotai/kimi-k2.5,qwen/qwen3-32b
OPENAI_TIMEOUT=40

########################
# 爬虫 / 第三方 API
########################

# RapidAPI 密钥（用于 Twitter/TikTok/Instagram 等社媒爬虫）
RAPIDAPI_KEY=your-rapidapi-key-1
RAPIDAPI_KEY_2=your-rapidapi-key-2
RAPIDAPI_KEY_3=your-rapidapi-key-3

########################
# 通知 & Webhook
########################

# 飞书机器人 Webhook（日报/周报推送）
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# 可选：飞书应用信息（如需要上传图片等能力）
FEISHU_APP_ID=your-feishu-app-id
FEISHU_APP_SECRET=your-feishu-app-secret

# 企业微信机器人 Webhook（周期周报可选使用）
WEWORK_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
WEWORK_MSG_TYPE=markdown  # 或 text

########################
# 路径 & 运行配置
########################

# 竞品输入 JSON 配置路径（不设置时，脚本会自动探测）
COMPETITOR_INPUT_PATH=input/twitter_input.json

# 历史数据 / 周报数据库目录（可选）
COMPETITOR_DB_DIR=db

# 报告输出目录（Markdown & JSON）
OUTPUT_DIR=output

# （可选）用于从 YAML 读取飞书 webhook 的配置文件路径
# 若不设置，将尝试默认的 /app/config/config.yaml 或 workflows 同级的 config/config.yaml
CONFIG_PATH=config/config.yaml

########################
# 代理（可选）
########################

PROXY_URL=http://your-proxy-host:7890
DISABLE_PROXY=true

